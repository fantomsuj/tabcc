{
  "manifest_version": 3,
  "name": "Mindful",
  "version": "0.1.0",
  "description": "Gentle nudges and batched review for tabs and downloads. Stop accumulating, start deciding.",
  "permissions": [
    "downloads",
    "tabs",
    "history",
    "storage",
    "alarms",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["nudge.js"],
      "css": ["nudge.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mindful",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["review.html", "nudge.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
